<launch>
  <!-- MPC-SECBF 数值仿真完整链路 -->
  <param name="/use_sim_time" value="false"/>

  <arg name="mpc_frequency" value="10"/>
  <arg name="pre_step"      value="20"/>
  <arg name="step_time"     value="0.2"/>
  <arg name="v_max"         default="1.5"/>
  <arg name="gamma"         value="0.35"/>
  <arg name="show_rviz"     default="true"/>
  <arg name="use_ground_truth" default="true"/>
  <arg name="front_adsm" default="true"/>
  <arg name="static_path"   default="false"/>
  <arg name="search_horizon" default="10.0"/>
  <arg name="map_size_x" default="50.0"/>
  <arg name="map_size_y" default="50.0"/>
  <arg name="map_size_z" default="3.0"/>
  <arg name="goal_x" default="10.0"/>
  <arg name="goal_y" default="0.0"/>
  <arg name="init_x" default="0.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="init_yaw" default="0.0"/>
  <arg name="scenario_id" default="head_on_context_ext"/>
  <arg name="baseline_id" default="B3_SECBF_with_guard"/>
  <arg name="guard_enabled" default="true"/>
  <arg name="mpc_feasibility_guard_enabled" default="true"/>
  <arg name="guard_kappa" default="0.5"/>
  <arg name="guard_max_backtracks" default="6"/>
  <arg name="guard_time_budget_ms" default="500.0"/>
  <arg name="guard_solver_max_cpu_time_ms" default="70.0"/>
  <arg name="guard_binary_search" default="false"/>
  <arg name="guard_bounded_midpoint_then_zero" default="false"/>
  <arg name="emergency_cbf_enabled" default="false"/>
  <arg name="emergency_cbf_alpha" default="1.5"/>
  <arg name="emergency_cbf_extra_margin" default="0.10"/>
  <arg name="emergency_cbf_v_max" default="0.35"/>
  <arg name="emergency_cbf_turn_gain" default="1.5"/>
  <arg name="emergency_cbf_activation_distance" default="4.0"/>
  <arg name="emergency_cbf_progress_v" default="0.20"/>
  <arg name="typed_payload_timeout" default="0.50"/>
  <arg name="side_preference_enabled" default="false"/>
  <arg name="side_weight" default="0.05"/>
  <arg name="side_epsilon_n" default="0.001"/>
  <arg name="side_horizon" default="20"/>
  <arg name="side_sign" default="1.0"/>
  <arg name="side_min_obstacle_speed" default="0.001"/>
  <arg name="side_activation_distance" default="3.0"/>
  <arg name="semantic_mode" default="full"/>
  <arg name="enable_rate_limit" default="true"/>
  <arg name="enable_available_projection" default="true"/>
  <arg name="enable_guard_fallback" default="true"/>
  <arg name="global_seesm_enable" default="false"/>
  <arg name="global_seesm_margin_topic" default="/safety_margin/beta_applied_final"/>
  <arg name="fixed_beta" default="0.4"/>
  <arg name="dynamic_tau_enabled" default="true"/>
  <arg name="dynamic_tau_mode" default="teacher_tca"/>
  <arg name="dynamic_tau_delta_tau" default="1e-6"/>
  <arg name="dynamic_tau_ke" default="0.30"/>
  <arg name="dynamic_tau_tmax" default="2.0"/>
  <arg name="dynamic_tau_min_speed" default="1e-6"/>
  <arg name="dynamic_tau_min_distance" default="1e-6"/>
  <arg name="dynamic_tau_max_tau" default="2.0"/>
  <arg name="epsilon_max" default="0.05"/>
  <arg name="slack_weight" default="1000.0"/>
  <arg name="qf_scale" default="1.1"/>
  <arg name="delta_u_weight" default="0.02"/>
  <arg name="delta_u_max" default="0.4"/>
  <arg name="active_set_distance_m" default="8.0"/>
  <arg name="graph_cache_enabled" default="false"/>
  <arg name="solver_max_cpu_time_ms" default="0.0"/>
  <arg name="safety_delta_bar" default="0.10"/>
  <arg name="safety_delta_beta_bar" default="0.30"/>
  <arg name="max_cbf_obstacles" default="6"/>
  <arg name="cbf_metric" default="seesm"/>
  <arg name="output_dir" default="$(find swarm_test)/output/secbf_runs/manual"/>
  <arg name="obstacle_classes" default="[child_like]"/>
  <arg name="obstacle_ids" default="[4000]"/>
  <arg name="beta_bar_box" default="0.20"/>
  <arg name="beta_bar_adult" default="0.75"/>
  <arg name="beta_bar_pedestrian" default="0.75"/>
  <arg name="beta_bar_child" default="1.05"/>
  <arg name="beta_bar_child_like" default="1.05"/>
  <arg name="beta_bar_cyclist" default="0.90"/>
  <arg name="beta_bar_vehicle" default="0.80"/>
  <arg name="beta_bar_unknown" default="0.75"/>
  <arg name="beta_max_box" default="$(arg beta_bar_box)"/>
  <arg name="beta_max_adult" default="$(arg beta_bar_adult)"/>
  <arg name="beta_max_pedestrian" default="$(arg beta_bar_pedestrian)"/>
  <arg name="beta_max_child" default="$(arg beta_bar_child)"/>
  <arg name="beta_max_child_like" default="$(arg beta_bar_child_like)"/>
  <arg name="beta_max_cyclist" default="$(arg beta_bar_cyclist)"/>
  <arg name="beta_max_vehicle" default="$(arg beta_bar_vehicle)"/>
  <arg name="beta_max_unknown" default="$(arg beta_bar_unknown)"/>
  <arg name="guard_h_min" default="0.10"/>
  <arg name="delta_beta_positive" default="0.30"/>
  <arg name="mu_bias" default="0.6"/>
  <arg name="mu_heading" default="0.2"/>
  <arg name="mu_ttc" default="0.15"/>
  <arg name="mu_density" default="0.1"/>

  <!-- 随机地图仿真环境 -->
  <include file="$(find map_generator)/launch/map.launch">
    <arg name="rviz_vis"    value="false"/>
    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    <arg name="c_num"       value="0"/>
    <arg name="p_num"       value="1"/>
  </include>

  <!-- 差速机器人数值仿真 -->
  <include file="$(find robot_simulator)/launch/scout_simulator.xml">
    <arg name="ugv_id"         value="1"/>
    <arg name="time_res_"      value="0.02"/>
    <arg name="init_x_"        value="$(arg init_x)"/>
    <arg name="init_y_"        value="$(arg init_y)"/>
    <arg name="init_z_"        value="0.2"/>
    <arg name="init_yaw_"      value="$(arg init_yaw)"/>
    <arg name="map_size_x_"    value="$(arg map_size_x)"/>
    <arg name="map_size_y_"    value="$(arg map_size_y)"/>
    <arg name="map_size_z_"    value="$(arg map_size_z)"/>
    <arg name="odometry_topic" value="/robot1/odom"/>
    <arg name="mesh_topic"     value="vis_mesh"/>
    <arg name="cmd_topic"      value="/cmd_vel1"/>
  </include>

  <!-- 全局路径搜索 (globalFsm_by_adsm) -->
  <include file="$(find traj_planner)/launch/plan_global_fsm.launch">
    <arg name="odometry_topic"          value="/robot1/odom"/>
    <arg name="cloud_topic"             value="/velodyne_points_world_no_use"/>
    <arg name="_perception_GroundTruth" value="$(arg use_ground_truth)"/>
    <arg name="pre_step_"         value="$(arg pre_step)"/>
    <arg name="step_time_"        value="$(arg step_time)"/>
    <arg name="used_DIS_"         value="false"/>
    <arg name="used_adsm_" value="$(arg front_adsm)"/>
    <arg name="used_static_path"  value="$(arg static_path)"/>
    <arg name="traj_horizon"      value="$(arg search_horizon)"/>
    <arg name="map_size_x_"       value="$(arg map_size_x)"/>
    <arg name="map_size_y_"       value="$(arg map_size_y)"/>
    <arg name="map_size_z_"       value="$(arg map_size_z)"/>
    <arg name="_goal_x"           value="$(arg goal_x)"/>
    <arg name="_goal_y"           value="$(arg goal_y)"/>
    <arg name="global_seesm_enable" value="$(arg global_seesm_enable)"/>
    <arg name="global_seesm_margin_topic" value="$(arg global_seesm_margin_topic)"/>
    <arg name="global_seesm_log_path" value="$(arg output_dir)/global_seesm_log.csv"/>
    <arg name="dynamic_tau_enabled" value="$(arg dynamic_tau_enabled)"/>
    <arg name="dynamic_tau_mode" value="$(arg dynamic_tau_mode)"/>
    <arg name="dynamic_tau_delta_tau" value="$(arg dynamic_tau_delta_tau)"/>
    <arg name="dynamic_tau_ke" value="$(arg dynamic_tau_ke)"/>
    <arg name="dynamic_tau_tmax" value="$(arg dynamic_tau_tmax)"/>
    <arg name="dynamic_tau_min_speed" value="$(arg dynamic_tau_min_speed)"/>
    <arg name="dynamic_tau_min_distance" value="$(arg dynamic_tau_min_distance)"/>
    <arg name="dynamic_tau_max_tau" value="$(arg dynamic_tau_max_tau)"/>
  </include>

  <!-- 本文语义 β + Guard (Ground Truth 模式: 跳过感知，类别来自场景配置) -->
  <include file="$(find semantic_guard)/launch/beta_ground_truth.launch">
    <arg name="log_path" value="$(arg output_dir)/margin_guard_log.csv"/>
    <arg name="pre_step" value="$(arg pre_step)"/>
    <arg name="step_time" value="$(arg step_time)"/>
    <arg name="guard_enabled" value="$(arg guard_enabled)"/>
    <arg name="semantic_mode" value="$(arg semantic_mode)"/>
    <arg name="enable_rate_limit" value="$(arg enable_rate_limit)"/>
    <arg name="enable_available_projection" value="$(arg enable_available_projection)"/>
    <arg name="enable_guard_fallback" value="$(arg enable_guard_fallback)"/>
    <arg name="fixed_beta" value="$(arg fixed_beta)"/>
    <arg name="dynamic_tau_enabled" value="$(arg dynamic_tau_enabled)"/>
    <arg name="dynamic_tau_mode" value="$(arg dynamic_tau_mode)"/>
    <arg name="dynamic_tau_delta_tau" value="$(arg dynamic_tau_delta_tau)"/>
    <arg name="dynamic_tau_ke" value="$(arg dynamic_tau_ke)"/>
    <arg name="dynamic_tau_tmax" value="$(arg dynamic_tau_tmax)"/>
    <arg name="dynamic_tau_min_speed" value="$(arg dynamic_tau_min_speed)"/>
    <arg name="dynamic_tau_min_distance" value="$(arg dynamic_tau_min_distance)"/>
    <arg name="dynamic_tau_max_tau" value="$(arg dynamic_tau_max_tau)"/>
    <arg name="scenario_id" value="$(arg scenario_id)"/>
    <arg name="baseline_id" value="$(arg baseline_id)"/>
    <arg name="odom_topic" value="/robot1/odom"/>
    <arg name="obstacle_classes" value="$(arg obstacle_classes)"/>
    <arg name="obstacle_ids" value="$(arg obstacle_ids)"/>
    <arg name="beta_bar_box" value="$(arg beta_bar_box)"/>
    <arg name="beta_bar_adult" value="$(arg beta_bar_adult)"/>
    <arg name="beta_bar_pedestrian" value="$(arg beta_bar_pedestrian)"/>
    <arg name="beta_bar_child" value="$(arg beta_bar_child)"/>
    <arg name="beta_bar_child_like" value="$(arg beta_bar_child_like)"/>
    <arg name="beta_bar_cyclist" value="$(arg beta_bar_cyclist)"/>
    <arg name="beta_bar_vehicle" value="$(arg beta_bar_vehicle)"/>
    <arg name="beta_bar_unknown" value="$(arg beta_bar_unknown)"/>
    <arg name="beta_max_box" value="$(arg beta_max_box)"/>
    <arg name="beta_max_adult" value="$(arg beta_max_adult)"/>
    <arg name="beta_max_pedestrian" value="$(arg beta_max_pedestrian)"/>
    <arg name="beta_max_child" value="$(arg beta_max_child)"/>
    <arg name="beta_max_child_like" value="$(arg beta_max_child_like)"/>
    <arg name="beta_max_cyclist" value="$(arg beta_max_cyclist)"/>
    <arg name="beta_max_vehicle" value="$(arg beta_max_vehicle)"/>
    <arg name="beta_max_unknown" value="$(arg beta_max_unknown)"/>
    <arg name="guard_h_min" value="$(arg guard_h_min)"/>
    <arg name="delta_beta_positive" value="$(arg delta_beta_positive)"/>
    <arg name="mu_bias" value="$(arg mu_bias)"/>
    <arg name="mu_heading" value="$(arg mu_heading)"/>
    <arg name="mu_ttc" value="$(arg mu_ttc)"/>
    <arg name="mu_density" value="$(arg mu_density)"/>
  </include>

  <!-- MPC-SECBF 控制器 -->
  <include file="$(find mpc_secbf)/launch/mpc_secbf.launch">
    <arg name="mpc_frequency" value="$(arg mpc_frequency)"/>
    <arg name="pre_step" value="$(arg pre_step)"/>
    <arg name="step_time" value="$(arg step_time)"/>
    <arg name="v_max" value="$(arg v_max)"/>
    <arg name="gamma" value="$(arg gamma)"/>
    <arg name="beta_bar_unknown" value="$(arg beta_bar_unknown)"/>
    <arg name="robot_radius" value="0.4"/>
    <arg name="epsilon_max" value="$(arg epsilon_max)"/>
    <arg name="slack_weight" value="$(arg slack_weight)"/>
    <arg name="qf_scale" value="$(arg qf_scale)"/>
    <arg name="delta_u_weight" value="$(arg delta_u_weight)"/>
    <arg name="delta_u_max" value="$(arg delta_u_max)"/>
    <arg name="active_set_distance_m" value="$(arg active_set_distance_m)"/>
    <arg name="graph_cache_enabled" value="$(arg graph_cache_enabled)"/>
    <arg name="solver_max_cpu_time_ms" value="$(arg solver_max_cpu_time_ms)"/>
    <arg name="safety_delta_bar" value="$(arg safety_delta_bar)"/>
    <arg name="safety_delta_beta_bar" value="$(arg safety_delta_beta_bar)"/>
    <arg name="max_cbf_obstacles" value="$(arg max_cbf_obstacles)"/>
    <arg name="cbf_metric" value="$(arg cbf_metric)"/>
    <arg name="mpc_feasibility_guard_enabled" value="$(arg mpc_feasibility_guard_enabled)"/>
    <arg name="guard_kappa" value="$(arg guard_kappa)"/>
    <arg name="guard_max_backtracks" value="$(arg guard_max_backtracks)"/>
    <arg name="guard_time_budget_ms" value="$(arg guard_time_budget_ms)"/>
    <arg name="guard_solver_max_cpu_time_ms" value="$(arg guard_solver_max_cpu_time_ms)"/>
    <arg name="guard_binary_search" value="$(arg guard_binary_search)"/>
    <arg name="guard_bounded_midpoint_then_zero" value="$(arg guard_bounded_midpoint_then_zero)"/>
    <arg name="emergency_cbf_enabled" value="$(arg emergency_cbf_enabled)"/>
    <arg name="emergency_cbf_alpha" value="$(arg emergency_cbf_alpha)"/>
    <arg name="emergency_cbf_extra_margin" value="$(arg emergency_cbf_extra_margin)"/>
    <arg name="emergency_cbf_v_max" value="$(arg emergency_cbf_v_max)"/>
    <arg name="emergency_cbf_turn_gain" value="$(arg emergency_cbf_turn_gain)"/>
    <arg name="emergency_cbf_activation_distance" value="$(arg emergency_cbf_activation_distance)"/>
    <arg name="emergency_cbf_progress_v" value="$(arg emergency_cbf_progress_v)"/>
    <arg name="typed_payload_timeout" value="$(arg typed_payload_timeout)"/>
    <arg name="side_preference_enabled" value="$(arg side_preference_enabled)"/>
    <arg name="side_weight" value="$(arg side_weight)"/>
    <arg name="side_epsilon_n" value="$(arg side_epsilon_n)"/>
    <arg name="side_horizon" value="$(arg side_horizon)"/>
    <arg name="side_sign" value="$(arg side_sign)"/>
    <arg name="side_min_obstacle_speed" value="$(arg side_min_obstacle_speed)"/>
    <arg name="side_activation_distance" value="$(arg side_activation_distance)"/>
    <arg name="dynamic_tau_enabled" value="$(arg dynamic_tau_enabled)"/>
    <arg name="dynamic_tau_mode" value="$(arg dynamic_tau_mode)"/>
    <arg name="dynamic_tau_delta_tau" value="$(arg dynamic_tau_delta_tau)"/>
    <arg name="dynamic_tau_ke" value="$(arg dynamic_tau_ke)"/>
    <arg name="dynamic_tau_tmax" value="$(arg dynamic_tau_tmax)"/>
    <arg name="dynamic_tau_min_speed" value="$(arg dynamic_tau_min_speed)"/>
    <arg name="dynamic_tau_min_distance" value="$(arg dynamic_tau_min_distance)"/>
    <arg name="dynamic_tau_max_tau" value="$(arg dynamic_tau_max_tau)"/>
    <arg name="odom_topic" value="/robot1/odom"/>
    <arg name="cmd_vel_topic" value="/cmd_vel1"/>
    <arg name="obstacle_snapshot_topic" value="/globalFsm_by_adsm/teacher_obstacle_snapshot"/>
    <arg name="beta_pre_guard_topic" value="/safety_margin/beta_pre_guard"/>
    <arg name="planner_log_path" value="$(arg output_dir)/planner_log.csv"/>
    <arg name="timing_log_path" value="$(arg output_dir)/timing_log.csv"/>
    <arg name="mpc_margin_log_path" value="$(arg output_dir)/mpc_margin_log.csv"/>
    <arg name="tau_stage_log_path" value="$(arg output_dir)/tau_stage_log.csv"/>
    <arg name="guard_attempt_log_path" value="$(arg output_dir)/guard_attempt_log.csv"/>
    <arg name="safety_recurrence_log_path" value="$(arg output_dir)/safety_recurrence_log.csv"/>
  </include>

  <!-- 轨迹可视化 -->
  <node pkg="swarm_test" type="odom_traj_visualization_node" name="odom_traj_visualization_node">
    <remap from="/odometry" to="/robot1/odom"/>
    <param name="odom_traj_vis/line_width"     value="0.05" type="double"/>
    <param name="odom_traj_vis/color_r"        value="0.0" type="double"/>
    <param name="odom_traj_vis/color_g"        value="0.8" type="double"/>
    <param name="odom_traj_vis/color_b"        value="0.2" type="double"/>
    <param name="odom_traj_vis/color_a"        value="1.0" type="double"/>
    <param name="odom_traj_vis/show_odom_size" value="1000" type="int"/>
  </node>

  <!-- RViz -->
  <node if="$(arg show_rviz)" pkg="rviz" type="rviz" name="rviz" output="log"
        args="-d $(find swarm_test)/config/acbf_plan.rviz"/>
</launch>
