<launch>

    <arg name="port_name" default="can0" />
    <arg name="simulated_robot" default="false" />
    <arg name="model_xacro" default="$(find scout_description)/urdf/scout_v2.xacro" />
    <arg name="odom_topic_name" default="odom" />
    <arg name="is_scout_mini" default="false" />
    <arg name="pub_tf" default="true" />

    <include file="$(find scout_base)/launch/scout_base.launch">
        <arg name="port_name" value="$(arg port_name)" />
        <arg name="simulated_robot" value="$(arg simulated_robot)" />
        <arg name="odom_topic_name" value="$(arg odom_topic_name)" />
	<arg name="is_scout_mini" value="$(arg is_scout_mini)" />
	<arg name="pub_tf" value="$(arg pub_tf)" />
    </include>

    <!-- 注释掉不存在的 description.launch；如需 URDF，用 display_scout_v2.launch -->
    <!--
    <include file="$(find scout_description)/launch/description.launch">
        <arg name="model_xacro" default="$(arg model_xacro)" />
    </include>
    -->

</launch>
