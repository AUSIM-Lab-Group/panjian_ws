<launch>

   <!-- 启动底盘 -->
  <!-- <include file="$(find scout_bringup)/launch/scout_mini_robot_base.launch" /> -->

  <!--起雷达驱动-->
  <include file="$(find rslidar_sdk)/launch/start.launch" />
  <!--起雷达话题转换节点-->
  <node name="rs_converter" pkg="rs_to_velodyne" type="rs_to_velodyne" args="XYZIRT XYZIRT">
  </node>

  <!--起惯导驱动-->
  <include file="$(find sbg_driver)/launch/examples/sbg_ellipseN.launch" />

  <!-- 启动FAST-LIO -->
  <include file="$(find fast_lio)/launch/state_estimation.launch">
    
  </include>

  <!--起lio_sam包-->
  <!-- <include file="$(find lio_sam)/launch/run.launch" /> -->

  <!-- 起D435相机 -->
  <include file="$(find realsense2_camera)/launch/rs_aligned_depth.launch"/>

  
  <!-- <node pkg="tf" type="static_transform_publisher" name="base_link_fp_base_link" args="0 0 0.2 0 0 0 /base_link_footprint /base_link 10" /> -->

  <!-- <node pkg="tf" type="static_transform_publisher" name="velodyne_base_link" args="0 0 0.30 0 0 0 /base_link /velodyne_link 10" /> -->


  <!-- <node pkg="tf" type="static_transform_publisher" name="velodyne_base_link" args="0 0 0 0 0 0 /base_link /velodyne 100" /> -->
</launch>
