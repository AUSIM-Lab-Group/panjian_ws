<launch>
  <arg name="image_topic" default="/camera/color/image_raw"/>
  <arg name="device" default="cuda:0"/>
  <arg name="confidence" default="0.5"/>

  <node pkg="semantic_detection" type="yolo_node.py" name="yolo_node" output="screen">
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="device" value="$(arg device)"/>
    <param name="confidence_threshold" value="$(arg confidence)"/>
    <param name="model_path" value="$(find semantic_detection)/models/yolov8n.pt"/>
  </node>
</launch>
